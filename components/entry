import tkinter as tk
import customtkinter as ctk

class Entry(ctk.CTkEntry):
    def __init__(self, master, placeholder):
        super().__init__(
            master,
            placeholder_text=placeholder,
            font=ctk.CTkFont("Inter Medium", 16),
            fg_color="#FDF4F7",
            height=30,
            border_width=2,
            border_color="#CFA4B5"
        )